   "source": [
    "# Write your code here\n",
    "r = 0.99\n",
    "omega_n = np.pi/4\n",
    "b = np.array([1, 0, -1])                     \n",
    "a = np.array([1, -2*r*np.cos(omega_n), r**2])  \n",
    "w = np.linspace(-np.pi, np.pi, 1024)\n",
    "z = np.exp(1j * w)\n",
    "num = b[0] + b[1]*z**(-1) + b[2]*z**(-2)\n",
    "den = a[0] + a[1]*z**(-1) + a[2]*z**(-2)\n",
    "H = num / den\n",
    "plot_frequency_response(w, H)\n"
