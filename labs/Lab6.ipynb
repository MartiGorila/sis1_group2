      "[0.5]\n",
      "[-1.]\n"
     ]
    }
   ],
   "source": [
    "# Write your code here\n",
    "r=0.5#if not it doesn't give a result\n",
    "a0=1\n",
    "a1=-r\n",
    "b0=1\n",
    "b1=1\n",
    "poles=np.roots([a0,a1])\n",
    "zeros=np.roots([b0,b1])\n",
    "print(poles)\n",
    "print(zeros)"
   ]
  },
